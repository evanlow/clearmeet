# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Authentication Configuration (Required)
AUTH_USERNAME=admin
AUTH_PASSWORD=your-secure-password-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Session Configuration
# SESSION_TYPE: 'null' (default, uses signed cookies - recommended for Heroku/production with multiple workers)
#               'cachelib' (server-side sessions - only for single-process development)
# SESSION_TYPE=null
PERMANENT_SESSION_LIFETIME=3600

# File Upload Configuration
MAX_CONTENT_LENGTH=209715200  # 200MB max request size
UPLOAD_FOLDER=temp_uploads
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_TRANSCRIBE_MODEL=whisper-1
